{
  "name": "clarity",
  "version": "0.1.0",
  "private": true,
  "description": "A private, local-first meeting copilot for macOS",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "build:native": "swift build -c release --package-path native/ClarityCapture",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --filter @clarity/desktop dev",
    "demo": "pnpm --filter @clarity/desktop demo",
    "e2e": "pnpm --filter @clarity/desktop e2e",
    "package:mac": "pnpm build:native && pnpm build && pnpm --filter @clarity/desktop package:mac",
    "test": "vitest run",
    "test:native": "node scripts/native-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "turbo": "2.8.14",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
